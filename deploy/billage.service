# /etc/systemd/system/billage.service
# Spring Boot 실행 유닛 (systemd). Docker 없이 JVM 직접 실행.

[Unit]
Description=Billage API Server
After=network.target docker.service
Wants=docker.service

[Service]
User=billage
Group=billage
WorkingDirectory=/opt/billage
EnvironmentFile=/etc/billage/billage.env

# t3.micro(1GB RAM) 메모리 예산: JVM(힙384m+비힙/스택 여유) + MySQL(mem_limit 360m)
# + Docker/Caddy/OS 를 1GB+스왑2G 안에 맞춘다. 힙을 384m 로 낮춰 호스트 여유 확보.
ExecStart=/usr/bin/java -Xms128m -Xmx384m -XX:+UseSerialGC -jar /opt/billage/billage.jar

SuccessExitStatus=143
Restart=always
RestartSec=5

# 보안 하드닝
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
