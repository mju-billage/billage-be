# /etc/billage/billage.env 로 복사해서 실제 값 채우기. (절대 Git 커밋 금지)
# systemd 가 이 파일을 읽어 Spring Boot 에 주입한다.

SPRING_PROFILES_ACTIVE=dev

# 외부 노출 차단: 앱을 로컬에만 리슨시키고 Caddy(reverse_proxy)만 접근.
# (보안그룹으로 8080 을 막더라도 이중 방어로 반드시 유지)
SERVER_ADDRESS=127.0.0.1

DB_URL=jdbc:mysql://localhost:3306/billage?connectionTimeZone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=billage
DB_PASSWORD=여기에_강한_비밀번호

# JWT HS256 서명키. HS256 은 최소 32바이트 필요 → 넉넉히 생성할 것.
#   생성 예: openssl rand -base64 48
# dev/prod 프로파일엔 기본값이 없으므로 이 값이 없으면 앱이 기동하지 못한다.
JWT_SECRET=여기에_openssl_rand_base64_48_결과

# 업로드 파일 저장소. S3 인증은 EC2 인스턴스 역할(billage-backup-role)로 처리하므로 액세스 키가 필요 없다.
BILLAGE_FILE_STORAGE=S3
BILLAGE_FILE_S3_BUCKET=billage-files-442908904609
BILLAGE_FILE_S3_PREFIX=dev

# 구글 간편 로그인. ID Token의 aud 검증에 쓰는 서버(Web) 클라이언트 ID (Google Cloud Console).
# 미설정 시 구글 로그인만 비활성화되고 나머지 기능은 정상 기동한다.
GOOGLE_CLIENT_ID=여기에_구글_웹_클라이언트_ID
